3224793341ee"],

Cell[TextData[{
 "Another way to restrict the output of ",
 Cell[BoxData["TranscendentalRange"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6fa4a6df-d5c6-4084-8334-51d757219dca"],
 " is by setting a threshold for the complexity of the numeric expressions \
involved through the option \"FormulaComplexity\". The corresponding \
numerical values have little relevance in practice and are assigned through a \
merely heuristic recipe. A user interested in precise computations of the \
underlying ",
 ButtonBox["homonymous function ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/PacletRepository/resources/\
DanieleGregori/GeneralizedRange/ref/FormulaComplexity.html"], None},
  ButtonNote->
   "https://resources.wolframcloud.com/PacletRepository/resources/\
DanieleGregori/GeneralizedRange/ref/FormulaComplexity.html"],
 "may use the paclet \"DanieleGregori/GeneralizedRange\"."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.981033979198084*^9, 3.981034392774331*^9}, {
   3.981046033986402*^9, 3.9810461536987667`*^9}, {3.9810461878713083`*^9, 
