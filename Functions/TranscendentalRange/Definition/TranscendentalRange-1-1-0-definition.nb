Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"methods", "=", "$invtrig"}], ",", 
     RowBox[{"multi", "=", "3"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"max", "=", 
        RowBox[{"3", "/", "2"}]}], ",", 
       RowBox[{"s", "=", "7"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"t", "->", 
        RowBox[{
         RowBox[{"testTR", "[", 
          RowBox[{"All", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "multi"}], "}"}], ",", 
           RowBox[{"Echo", "@", 
            RowBox[{"Append", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Round", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"1", "/", 
                   RowBox[{"Denominator", "@", "max"}]}]}], "]"}], "&"}], "/@", 
               RowBox[{"Sort", "@", 
