Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"complexitySelect", "[", 
    RowBox[{"list_List", ",", "c_"}], "]"}], ":=", "\n", "\t", 
   RowBox[{"Select", "[", 
    RowBox[{"list", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"formulaComplexity", "[", "#", "]"}], "<=", "c"}], "&"}]}], 
    "]"}]}], "\n"}], "\n", 
 RowBox[{"ClearAll", "[", "stepSelect", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stepSelect", "[", 
    RowBox[{"list_List", ",", "d_"}], "]"}], ":=", "\n", "\t", 
   RowBox[{
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sel", ",", "eln", ",", "i"}], "}"}], ",", "\n", "\t", 
      RowBox[{
       RowBox[{"eln", "=", 
        RowBox[{"list", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"sel", "=", 
        RowBox[{"CreateDataStructure", "[", "\"\<DynamicArray\>\"", "]"}]}], ";",
        "\n", "\t", 
       RowBox[{"sel", "[", 
        RowBox[{"\"\<Append\>\"", ",", "eln"}], "]"}], ";", "\n", "\n", "\t", 
       
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "2"}], ",", 
         RowBox[{"i", "<=", 
          RowBox[{"Length", "[", "list", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\n", "\n", "\t\t", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"list", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "-", "eln"}], "]"}], ">=", 
            "d"}], ",", "\n", "\n", "\t\t\t", 
           RowBox[{
            RowBox[{"eln", "=", 
             RowBox[{"list", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "\t\t\t", 
            RowBox[{"sel", "[", 
             RowBox[{"\"\<Append\>\"", ",", "eln"}], "]"}]}], ",", "\n", "\n",
            "\t\t\t", 
           RowBox[{"Continue", "[", "]"}]}], "]"}]}], "]"}], ";", "\n", "\n", 
       "\t", 
       RowBox[{"Normal", "@", "sel"}]}]}], "]"}], "~", "Quiet", "~", 
    RowBox[{"N", "::", "meprec"}]}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stepSelect", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "d_"}], "]"}], ":=", "\n", "\t", 
   RowBox[{"{", "}"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"stepSelect", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "d_", ",", 
    RowBox[{"t_", ":", "0"}]}], "]"}], ":=", "\n", "\t", 
  RowBox[{"{", "}"}]}]}], "Input",
 TaggingRules->{},
 InitializationCell->True,
 CellLabel->"In[10]:=",ExpressionUUID->"71362dd4-2d31-47bb-a0e9-fe1c8ec0acfa"],

