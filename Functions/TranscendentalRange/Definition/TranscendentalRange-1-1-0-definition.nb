4af1bdef5108"],

Cell[TextData[{
 "For the method ",
 ButtonBox["Power",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Power"],
 ", only algebraic irrational generators in the exponent ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "3dff4e54-5cbd-4500-9f16-26d2ae5f7b93"],
 " can produce transcendental numbers. Correspondingly, the option \
\"Multiplicity\" generates product combinations."
}], "Notes",
 TaggingRules-><|
