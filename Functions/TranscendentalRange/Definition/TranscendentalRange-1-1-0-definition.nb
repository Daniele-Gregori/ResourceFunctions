Cell[TextData[{
 "The convergence of ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["RootApproximant", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/RootApproximant",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4575449b-f232-4975-ba4f-29c2d3e42d69"],
 " is slower but necessarily happens after about 512 approximation digits:"
}], "Text",
 TaggingRules->{},
