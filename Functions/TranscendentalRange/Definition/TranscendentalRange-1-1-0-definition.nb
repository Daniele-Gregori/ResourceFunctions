                 "\n", "\t\t\t", 
                RowBox[{"Select", "[", 
                 RowBox[{"rgmain", ",", 
                  RowBox[{"domain", "[", "fun", "]"}]}], "]"}], ",", "\n", 
                "\n", "\t\t", "True", ",", "\n", "\t\t\t", "rgmain"}], "\n", 
               "\t\t", "]"}]}], "]"}], "//", "Flatten"}], ",", "\n", 
           RowBox[{
            RowBox[{"min", "<=", "#", "<=", "max"}], "&"}]}], "]"}], ",", 
