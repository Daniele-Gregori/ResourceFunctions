Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"methods", "=", 
      RowBox[{"{", 
       RowBox[{"Exp", ",", "Log", ",", "Power"}], "}"}]}], ",", 
     RowBox[{"multi", "=", "3"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"max", "=", 
        RowBox[{"3", "/", "2"}]}], ",", 
       RowBox[{"s", "=", "7"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"t", "->", 
        RowBox[{
         RowBox[{"testTR", "[", 
          RowBox[{"All", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "multi"}], "}"}], ",", 
           RowBox[{"Echo", "@", 
            RowBox[{"Append", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Round", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"1", "/", 
                   RowBox[{"Denominator", "@", "max"}]}]}], "]"}], "&"}], "/@", 
               RowBox[{"Sort", "@", 
                RowBox[{"RandomReal", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "max"}], ",", "max"}], "}"}], ",", "2"}], 
                 "]"}]}]}], ",", 
              RowBox[{"Divide", "@@", 
               RowBox[{"RandomInteger", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"1", ",", "s"}], "}"}], ",", "2"}], "]"}]}]}], 
             "]"}]}], ",", 
           RowBox[{"\"\<GeneratorsDomain\>\"", "->", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"t", "===", "Power"}], ",", "Algebraics", ",", 
              "Rationals"}], "]"}]}]}], "]"}], "~", "TimeConstrained", "~", 
         "30"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "methods"}], "}"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
