  3.980784278634576*^9, 3.980784359239295*^9}, {3.980784414544129*^9, 
  3.980784414884655*^9}},ExpressionUUID->"61284b8f-09fd-4e93-90b9-\
b7b035f276c4"],

Cell[TextData[{
 "By default, the range elements are generated according to the \
Lindemann-Weierstrass theorem, that is linear combinations of exponentials ",
 Cell[BoxData[
  FormBox[Cell[TextData[Cell[BoxData[
    FormBox[
     RowBox[{
      SubscriptBox["t", "i"], "=", " ", 
      RowBox[{"b", " ", Cell[TextData[Cell[BoxData[
        FormBox[
         SuperscriptBox["\[ExponentialE]", "a"], TraditionalForm]],
        ExpressionUUID->"0e7a524d-7baa-4725-a8d5-cca0b304e0dd"]],
        ExpressionUUID->"4e4ab995-d86b-407f-ac8d-2263059c4ce2"]}]}], 
     TraditionalForm]],ExpressionUUID->
    "34245098-71a9-4563-bb74-1b37f403e0b3"]],ExpressionUUID->
    "fef41d2e-dbb7-417e-94a7-d8d61f9a9506"], TraditionalForm]],ExpressionUUID->
  "e02de66a-56e2-4242-a70a-e92d8ec1a864"],
 ", ",
 ButtonBox["for all",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ForAll"],
 " ",
 ButtonBox["algebraic",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Algebraics"],
 " arguments and coefficients ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "b1f5e60d-1367-4414-99cb-2dbbc156b19f"],
 ", ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "bacccc60-9d5e-4da6-834f-f96199af1bcb"],
 " that are ",
 ButtonBox["members",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MemberQ"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TagBox[
     ButtonBox[
      StyleBox["Range", "SymbolsRefLink",
       ShowStringCharacters->True,
       FontFamily->"Source Sans Pro"],
      BaseStyle->Dynamic[
        FEPrivate`If[
         CurrentValue["MouseOver"], {
         "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
      ButtonData->"paclet:ref/Range",
      ContentPadding->False],
     MouseAppearanceTag["LinkHand"]], "[", 
    RowBox[{"x", ",", "y"}], "]"}], TraditionalForm]],ExpressionUUID->
  "cd221d48-e958-4c4a-904d-58dddb3fd6ce"],
 ", or possibly ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TagBox[
     ButtonBox[
      StyleBox["Range", "SymbolsRefLink",
       ShowStringCharacters->True,
       FontFamily->"Source Sans Pro"],
      BaseStyle->Dynamic[
        FEPrivate`If[
         CurrentValue["MouseOver"], {
         "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
      ButtonData->"paclet:ref/Range",
      ContentPadding->False],
     MouseAppearanceTag["LinkHand"]], "[", 
    RowBox[{"x", ",", "y", ",", "s"}], "]"}], TraditionalForm]],
  ExpressionUUID->"8298a41b-6366-4595-9592-b5de9f166f96"],
 " using also a step parameter ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "2ff41508-9517-47fc-a369-7225da7f17d3"],
 " as third argument."
}], "Notes",
 TaggingRules-><|
  "ChatNotebookSettings" -> <|
    "InheritanceTest" -> True, 
