                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "max"}], ",", "max"}], "}"}], ",", "2"}], 
                 "]"}]}]}], ",", 
              RowBox[{"Divide", "@@", 
               RowBox[{"RandomInteger", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"1", ",", "s"}], "}"}], ",", "2"}], "]"}]}]}], 
             "]"}]}]}], "]"}], "~", "TimeConstrained", "~", "30"}]}], ",", 
