Cell[BoxData[{
 RowBox[{"ClearAll", "[", "testTR", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "testTR", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Timing\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<Detail\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<GeneratorsDomain\>\"", "->", "Rationals"}], ",", 
      RowBox[{"\"\<Multiplicity\>\"", "->", "1"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"testTR", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f_", ",", "ord_"}], "}"}], ",", "x_", ",", "y_", ",", "z_", ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "testTR", "]"}]}]}], "]"}], ":=", 
   "\[IndentingNewLine]", "\t", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "default", ",", "testing", ",", "timedef", ",", "timetest", ",", 
       "algGen"}], "}"}], ",", "\[IndentingNewLine]", "\t\t", 
     "\[IndentingNewLine]", 
     RowBox[{
