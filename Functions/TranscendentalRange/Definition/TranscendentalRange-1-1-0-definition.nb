       SelectedNotebook[], All, CellContents, AutoScroll -> True]], 
   PassEventsDown -> False, PassEventsUp -> False},
 CellChangeTimes->{{3.973960503647724*^9, 3.9739605635513687`*^9}, {
  3.981463654991064*^9, 3.981463663520404*^9}, {3.988387081456945*^9, 
