Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"elemNaiveRange", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fun", ":", 
        RowBox[{"_Symbol", "|", "_String"}], ":", "Exp"}], ",", "m_Integer"}],
       "}"}], ",", 
     RowBox[{"opt_String", ":", "\"\<Rational\>\""}], ",", 
     RowBox[{"prec_", ":", "MachinePrecision"}]}], "]"}], "/;", 
   RowBox[{
    RowBox[{"m", ">", "1"}], "&&", 
    RowBox[{"NumericQ", "[", "z", "]"}]}]}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"base", ",", "combined", ",", "op", ",", 
      RowBox[{"min", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"x", "<", "y"}], ",", "x", ",", "y"}], "]"}]}], ",", 
      RowBox[{"max", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"x", "<", "y"}], ",", "y", ",", "x"}], "]"}]}], ",", "rpl"}],
      "}"}], ",", 
    RowBox[{
     RowBox[{"rpl", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"fun", "=!=", "Power"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Times", "[", 
           RowBox[{"a_", ",", 
            RowBox[{"fun", "[", "arg_", "]"}]}], "]"}], "|", 
          RowBox[{"fun", "[", "arg_", "]"}]}], ":>", 
         RowBox[{"Abs", "@", 
          RowBox[{"N", "[", 
           RowBox[{"arg", ",", "prec"}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"Power", "[", 
          RowBox[{"b_", ",", "e_"}], "]"}], ":>", 
         RowBox[{
          RowBox[{"Abs", "@", 
           RowBox[{"N", "[", 
            RowBox[{"b", ",", "prec"}], "]"}]}], "+", 
          RowBox[{"Abs", "@", 
           RowBox[{"N", "[", 
            RowBox[{"e", ",", "prec"}], "]"}]}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"base", "=", 
      RowBox[{"Values", "@", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"First", "@", 
           RowBox[{"MinimalBy", "[", 
            RowBox[{"#", ",", 
             RowBox[{
              RowBox[{"#", "/.", "rpl"}], "&"}], ",", "1"}], "]"}]}], "&"}], ",", 
         RowBox[{"GroupBy", "[", 
          RowBox[{
           RowBox[{"elemNaiveRange", "[", 
            RowBox[{"x", ",", "y", ",", "z", ",", 
             RowBox[{"{", 
              RowBox[{"fun", ",", "1"}], "}"}], ",", "opt"}], "]"}], ",", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{"#", ",", "prec"}], "]"}], "&"}]}], "]"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"op", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"fun", "===", "Power"}], ",", "Times", ",", "Plus"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"combined", "=", "base"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"combined", "=", 
        RowBox[{"Values", "@", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"First", "@", 
             RowBox[{"MinimalBy", "[", 
              RowBox[{"#", ",", 
               RowBox[{
                RowBox[{"#", "/.", "rpl"}], "&"}], ",", "1"}], "]"}]}], "&"}],
            ",", 
           RowBox[{"GroupBy", "[", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"Union", "@", 
                RowBox[{"Flatten", "@", 
                 RowBox[{"Outer", "[", 
                  RowBox[{"op", ",", "combined", ",", "base"}], "]"}]}]}], ",", 
               RowBox[{
                RowBox[{"min", "<=", "#", "<=", "max"}], "&"}]}], "]"}], ",", 
             
             RowBox[{
              RowBox[{"N", "[", 
               RowBox[{"#", ",", "prec"}], "]"}], "&"}]}], "]"}]}], "]"}]}]}],
        ",", 
       RowBox[{"{", 
        RowBox[{"m", "-", "1"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{"combined", ",", 
       RowBox[{"_", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Element", "[", 
            RowBox[{"#", ",", "Algebraics"}], "]"}], "||", 
           RowBox[{
            RowBox[{"Abs", "@", 
