Cell["Final range", "Subsubsection",
 TaggingRules->{},ExpressionUUID->"b5f724db-9945-412d-918b-d844ecdf0e7e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "TranscendentalRange", "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TranscendentalRange", "[", 
    RowBox[{"x_", ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "TranscendentalRange", "]"}]}]}], "]"}], 
   ":=", "\n", "\t", 
   RowBox[{"TranscendentalRange", "[", 
    RowBox[{"1", ",", "x", ",", "1", ",", "0", ",", "opts"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TranscendentalRange", "[", 
    RowBox[{"x_", ",", "y_", ",", 
     RowBox[{"z_", ":", "1"}], ",", 
     RowBox[{"d_", ":", "0"}], ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "TranscendentalRange", "]"}]}]}], "]"}], 
   "/;", 
   RowBox[{
    RowBox[{"NumericQ", "[", "d", "]"}], "&&", 
    RowBox[{"NumericQ", "[", "z", "]"}]}]}], ":=", "\n", "\t", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "optmeth", ",", "optmulti", ",", "optprec", ",", "optcompl", ",", 
      "opttest", ",", "optalg", ",", "fullrange", ",", "restrcompl", ",", 
      "restrstep"}], "}"}], ",", "\n", "\n", "\t", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"Element", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "Algebraics"}], 
         "]"}]}], ",", "\n", "\t\t\t", 
       RowBox[{"Return", "@", 
        RowBox[{"failureNotAlgebraics", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}]}]}], "]"}], ";", 
     "\n", "\n", "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "optmeth", ",", "optmulti", ",", "optprec", ",", "optcompl", ",", 
        "opttest"}], "}"}], "=", "\[IndentingNewLine]", "\t", 
      RowBox[{"OptionValue", "[", 
       RowBox[{"{", 
        RowBox[{
        "Method", ",", "\"\<Multiplicity\>\"", ",", "WorkingPrecision", 
         ",", "\"\<FormulaComplexity\>\"", ",", "\"\<Test\>\""}], "}"}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\n", "\t", 
     RowBox[{"optalg", "=", 
      RowBox[{"optGenerators", "[", "opts", "]"}]}], ";", "\n", "\n", "\t", 
     RowBox[{"fullrange", "=", "\[IndentingNewLine]", "\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"opttest", "||", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"$trig", ",", "optmeth"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\t\t", 
        RowBox[{"sortNaiveRange", "[", "\[IndentingNewLine]", "\t\t\t", 
         RowBox[{
         "x", ",", "y", ",", "z", ",", "\[IndentingNewLine]", "\t\t\t", 
          "optmeth", ",", "\[IndentingNewLine]", "\t\t\t", 
          RowBox[{"\"\<Multiplicity\>\"", "->", "optmulti"}], ",", 
          "\[IndentingNewLine]", "\t\t\t", 
          RowBox[{"\"\<GeneratorsDomain\>\"", "->", "optalg"}], ",", 
          "\[IndentingNewLine]", "\t\t\t", 
          RowBox[{"WorkingPrecision", "->", "optprec"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\t\t", 
        RowBox[{"Which", "[", "\n", "\n", "\t\t\t\t", 
         RowBox[{
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"$methodSpecs", ",", "optmeth"}], "]"}], ",", "\n", 
          "\t\t\t\t", 
          RowBox[{
           RowBox[{
            RowBox[{"Which", "[", "\[IndentingNewLine]", "\t\t\t", 
             RowBox[{
              RowBox[{"optmulti", "===", "1"}], ",", "\[IndentingNewLine]", 
              "\t\t\t", "#", ",", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", "\t\t\t", 
              RowBox[{
               RowBox[{"IntegerQ", "[", "optmulti", "]"}], "&&", 
               RowBox[{"optmulti", ">=", "2"}]}], ",", "\[IndentingNewLine]", 
              "\t\t\t\t", 
              RowBox[{
              "transcendentalRangeMultiple", "[", "\[IndentingNewLine]", 
               "\t\t\t\t", 
               RowBox[{"#", ",", "\[IndentingNewLine]", "\t\t\t\t", 
                RowBox[{"{", 
                 RowBox[{"optmeth", ",", "optmulti"}], "}"}], ",", 
                "\[IndentingNewLine]", "\t\t\t\t", 
                RowBox[{"{", 
                 RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
                "\[IndentingNewLine]", "\t\t\t\t", "optprec"}], "]"}], ",", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", "\t\t\t", "True", 
              ",", "\[IndentingNewLine]", "\t\t\t", "$Failed"}], "]"}], "&"}],
            "@", "\[IndentingNewLine]", "\t\t\t\t\t\t", 
           RowBox[{
           "transcendentalRangeSingle", "[", "\[IndentingNewLine]", 
            "\t\t\t\t\t\t\t", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"optmeth", ",", "1"}], "}"}], ",", 
             "\[IndentingNewLine]", "\t\t\t\t\t\t\t", "x", ",", "y", ",", "z",
              ",", "\[IndentingNewLine]", "\t\t\t\t\t\t\t", "opts"}], "]"}]}],
           ",", "\n", "\n", "\t\t\t\t", 
          RowBox[{"ListQ", "[", "optmeth", "]"}], ",", "\[IndentingNewLine]", 
          "\t\t\t", 
          RowBox[{"combineMethod", "[", 
           RowBox[{
           "optmeth", ",", "x", ",", "y", ",", "z", ",", "d", ",", "opts"}], 
           "]"}], ",", "\n", "\n", "\t\t\t\t", 
          RowBox[{"optmeth", "===", "All"}], ",", "\[IndentingNewLine]", 
          "\t\t\t", 
          RowBox[{"combineMethod", "[", 
           RowBox[{
           "$trsctypes", ",", "x", ",", "y", ",", "z", ",", "d", ",", 
            "opts"}], "]"}], ",", "\[IndentingNewLine]", "\n", "\t\t\t\t", 
          "True", ",", "\n", "\t\t\t\t", "$Failed"}], "]"}]}], "]"}]}], ";", 
     "\n", "\t\t\t", "\n", "\n", "\t\t", 
     RowBox[{"restrcompl", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"optcompl", "<", "Infinity"}], ",", "\n", "\t\t\t", 
        RowBox[{"complexitySelect", "[", 
         RowBox[{"fullrange", ",", "optcompl"}], "]"}], ",", "\n", "\t\t\t", 
        "fullrange"}], "]"}]}], ";", "\n", "\n", "\t\t", 
     RowBox[{"restrstep", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"d", ">", "0"}], ",", "\n", "\t\t\t", 
        RowBox[{"stepSelect", "[", 
         RowBox[{"restrcompl", ",", "d"}], "]"}], ",", "\n", "\t\t\t", 
        "restrcompl"}], "]"}]}]}]}], "]"}]}]}], "Input",
 TaggingRules->{},
 InitializationCell->True,
