              RowBox[{"#", ",", "prec"}], "]"}]}], "<", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "prec"}], "+", "1"}], ")"}]}]}]}], "&"}], 
         ")"}]}]}], "]"}]}]}], "]"}]}]], "Input",
