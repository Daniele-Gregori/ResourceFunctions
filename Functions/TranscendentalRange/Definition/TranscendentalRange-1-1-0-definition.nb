Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SqrtBox["3"], " ", 
    RowBox[{"Tanh", "[", 
     SqrtBox["3"], "]"}]}], ",", 
   FractionBox[
    RowBox[{"2", " ", 
     RowBox[{"Coth", "[", 
      FractionBox["4", "3"], "]"}]}], 
    SqrtBox["3"]], ",", 
   FractionBox[
    RowBox[{"3", " ", 
     RowBox[{"Cot", "[", "1", "]"}]}], "2"], ",", 
