 RowBox[{
  RowBox[{"transcendentalRangeSingle", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "i_"}], "}"}], ",", "x_", ",", "y_", ",", 
    RowBox[{"z_", ":", "1"}], ",", 
    RowBox[{"opts", ":", 
     RowBox[{"OptionsPattern", "[", "transcendentalRangeSingle", "]"}]}]}], 
   "]"}], ":=", "\n", "\n", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"prec", "=", 
       RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ",", "rg", ",",
       "rpl", ",", "sby", ",", "ddby"}], "}"}], ",", "\n", "\n", "\t\t", 
    RowBox[{"(*", 
     RowBox[{"raw", " ", "redundant", " ", "range"}], "*)"}], "\n", "\t\t", 
    RowBox[{
     RowBox[{"rg", "=", 
      RowBox[{"coreRange", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"f", ",", "i"}], "}"}], ",", "x", ",", "y", ",", "z", ",", 
        RowBox[{"optGenerators", "[", "opts", "]"}]}], "]"}]}], ";", "\n", 
     "\n", "\t\t", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"delete", " ", "duplicates", " ", "by", " ", "N"}], " ", "+", 
       " ", 
       RowBox[{
       "choose", " ", "the", " ", "one", " ", "with", " ", "minimal", " ", 
        "argument"}]}], "*)"}], "\n", "\t\t", 
     RowBox[{"rpl", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{"i", ",", "\n", "\t\t\t\t\t", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{
         RowBox[{"f", "[", "arg_", "]"}], ":>", 
         RowBox[{"Abs", "@", 
          RowBox[{"N", "[", 
           RowBox[{"arg", ",", "prec"}], "]"}]}]}], ",", "\n", "\t\t\t\t\t", 
        "1", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Times", "[", 
           RowBox[{"a_", ",", " ", 
            RowBox[{"f", "[", "arg_", "]"}]}], "]"}], "|", 
          RowBox[{"f", "[", "arg_", "]"}]}], ":>", 
         RowBox[{"Abs", "@", 
          RowBox[{"N", "[", 
           RowBox[{"arg", ",", "prec"}], "]"}]}]}]}], "]"}]}], ";", "\n", 
     "\t\t", 
     RowBox[{"ddby", "=", 
      RowBox[{"Values", "@", 
       RowBox[{"Map", "[", "\n", "\t\t\t", 
        RowBox[{
         RowBox[{
          RowBox[{"First", "@", 
           RowBox[{"MinimalBy", "[", 
            RowBox[{"#", ",", 
             RowBox[{
              RowBox[{"#", "/.", "rpl"}], "&"}], ",", "1"}], "]"}]}], "&"}], ",",
          "\n", "\n", "\t\t\t", 
         RowBox[{"GroupBy", "[", 
          RowBox[{"rg", ",", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{"#", ",", "prec"}], "]"}], "&"}]}], "]"}]}], "]"}]}]}], ";",
      "\n", "\n", "\t\t", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"(", "rev", ")"}], "sort", " ", "by", " ", "N"}], "*)"}], "\n",
      "\t\t", 
     RowBox[{"sby", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"z", ">", "0"}], ",", "SortBy", ",", "ReverseSortBy"}], 
       "]"}]}], ";", "\n", "\t\t", 
     RowBox[{"sby", "[", 
      RowBox[{"ddby", ",", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"#", ",", "prec"}], "]"}], "&"}]}], "]"}]}]}], 
   "]"}]}]}], "Code",
