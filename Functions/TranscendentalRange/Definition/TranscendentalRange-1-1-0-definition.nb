Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"method", "=", "Log"}], ",", 
      RowBox[{"multi", "=", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"detailQ", "=", "True"}], ",", 
      RowBox[{"tries", "=", "3"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"diff", "=", "10"}], ",", 
      RowBox[{"s", "=", "7"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"args", "=", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", "5"}], "}"}], "]"}], ",", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"5", "+", "diff"}], ",", 
               RowBox[{"10", "+", "diff"}]}], "}"}], "]"}], ",", 
            RowBox[{
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{"1", ",", "s"}], "}"}], "]"}], "/", 
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{"1", ",", "s"}], "}"}], "]"}]}]}], "}"}], "//", 
          "Echo"}]}], "}"}], ",", 
       RowBox[{"testTR", "[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"method", ",", "multi"}], "}"}], ",", "args", ",", 
         RowBox[{"\"\<Detail\>\"", "->", "detailQ"}]}], "]"}]}], "]"}], "~", 
     "Table", "~", "tries"}]}], "]"}], "*)"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.988862907048497*^9, 3.9888629283228407`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"1cf23b6c-2c08-4aea-a979-dad270d85098"]
