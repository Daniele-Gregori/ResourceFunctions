Cell[CellGroupData[{

Cell["FareyRange", "Subsubsection",
 TaggingRules->{},ExpressionUUID->"1895ef2c-75c7-4fa0-935f-69020e0f3255"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "fareyRange", "]"}], "\n", 
 RowBox[{
  RowBox[{"fareyRange", "[", 
   RowBox[{"r1_", ",", "r2_", ",", "r3_"}], "]"}], ":=", "\n", "\t", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"r3", ">=", "1"}], ",", "\n", "\t\t", 
    RowBox[{
     RowBox[{"ResourceFunction", "[", "\"\<FareyRange\>\"", "]"}], "[", 
     RowBox[{"r1", ",", "r2", ",", "r3"}], "]"}], ",", "\n", "\t\t", 
    RowBox[{"Which", "[", 
     RowBox[{"(*", 
      RowBox[{
      "intuitive", " ", "alternative", " ", "reciprocal", " ", "step"}], 
      "*)"}], "\n", "\t\t\t", 
     RowBox[{
      RowBox[{"MatchQ", "[", 
       RowBox[{"r3", ",", 
        RowBox[{"Rational", "[", 
         RowBox[{"1", ",", "_"}], "]"}]}], "]"}], ",", "\n", "\t\t\t\t", 
      RowBox[{
       RowBox[{"ResourceFunction", "[", "\"\<FareyRange\>\"", "]"}], "[", 
       RowBox[{"r1", ",", "r2", ",", 
        RowBox[{"1", "/", "r3"}]}], "]"}], ",", "\n", "\t\t\t", 
      RowBox[{"MatchQ", "[", 
       RowBox[{"r3", ",", 
        RowBox[{"Rational", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "_"}], "]"}]}], "]"}], ",", "\n", 
      "\t\t\t\t", 
      RowBox[{"Reverse", "[", 
       RowBox[{
        RowBox[{"ResourceFunction", "[", "\"\<FareyRange\>\"", "]"}], "[", 
        RowBox[{"r2", ",", "r1", ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "r3"}]}], "]"}], "]"}], ",", "\n", 
      "\t\t\t", "True", ",", "\n", "\t\t\t\t", 
      RowBox[{"failureFareyStep", "[", "r3", "]"}]}], "]"}]}], 
   "]"}]}]}], "Input",
 TaggingRules->{},
 InitializationCell->True,
 CellLabel->"In[18]:=",ExpressionUUID->"cc350c02-7754-459d-9ce6-21b46434cbf6"]
}, Closed]],

