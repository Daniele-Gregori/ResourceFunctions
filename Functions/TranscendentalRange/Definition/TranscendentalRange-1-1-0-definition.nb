Cell[BoxData[
 RowBox[{
  RowBox[{"monotonicOuter", "[", 
   RowBox[{"fun_Function", ",", 
    RowBox[{"{", 
     RowBox[{"min_", ",", "max_"}], "}"}], ",", "ls1_List", ",", "ls2_List", ",", 
    RowBox[{"{", 
     RowBox[{"mi_", ",", "mj_"}], "}"}], ",", "sign_"}], "]"}], ":=", "\n", 
  "\t", 
  RowBox[{
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "i", ",", "j", ",", "new", ",", "begin", ",", "end", ",", "rgQ", ",", 
       "outer"}], "}"}], ",", "\n", "\n", "\t\t", 
     RowBox[{
      RowBox[{"outer", "=", 
       RowBox[{"CreateDataStructure", "[", "\"\<DynamicArray\>\"", "]"}]}], ";",
       "\n", "\n", "\t\t", 
      RowBox[{"For", "[", "\n", "\t\t\t", 
       RowBox[{
        RowBox[{"Switch", "[", 
         RowBox[{"mi", ",", "\n", "\t\t\t\t\t", "1", ",", 
          RowBox[{"i", "=", "1"}], ",", "\n", "\t\t\t\t\t", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"i", "=", 
           RowBox[{"Length", "[", "ls1", "]"}]}]}], "]"}], ",", "\n", 
        "\t\t\t", 
        RowBox[{"Switch", "[", 
         RowBox[{"mi", ",", "\n", "\t\t\t\t\t", "1", ",", 
          RowBox[{"i", "<=", 
           RowBox[{"Length", "[", "ls1", "]"}]}], ",", "\n", "\t\t\t\t\t", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"i", ">=", "1"}]}], "]"}], ",", "\n", "\t\t\t", 
        RowBox[{"Switch", "[", 
         RowBox[{"mi", ",", "\n", "\t\t\t\t\t", "1", ",", 
          RowBox[{"i", "++"}], ",", "\n", "\t\t\t\t\t", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"i", "--"}]}], "]"}], ",", "\n", "\n", "\t\t\t", 
        RowBox[{
         RowBox[{"begin", "=", "True"}], ";", "\n", "\n", "\t\t\t", 
         RowBox[{"end", "=", "False"}], ";", "\n", "\n", "\t\t\t", 
         RowBox[{"For", "[", "\n", "\n", "\t\t\t\t", 
          RowBox[{
           RowBox[{"Switch", "[", 
            RowBox[{"mj", ",", "\n", "\t\t\t\t\t", "1", ",", 
             RowBox[{"j", "=", "1"}], ",", "\n", "\t\t\t\t\t", 
             RowBox[{"-", "1"}], ",", 
             RowBox[{"j", "=", 
              RowBox[{"Length", "[", "ls2", "]"}]}]}], "]"}], ",", "\n", 
           "\t\t\t\t", 
           RowBox[{"Switch", "[", 
            RowBox[{"mj", ",", "\n", "\t\t\t\t\t", "1", ",", 
             RowBox[{"j", "<=", 
              RowBox[{"Length", "[", "ls2", "]"}]}], ",", "\n", "\t\t\t\t\t", 
             
             RowBox[{"-", "1"}], ",", 
             RowBox[{"j", ">=", "1"}]}], "]"}], ",", "\n", "\t\t\t\t", 
           RowBox[{"Switch", "[", 
            RowBox[{"mj", ",", "\n", "\t\t\t\t\t", "1", ",", 
             RowBox[{"j", "++"}], ",", "\n", "\t\t\t\t\t", 
             RowBox[{"-", "1"}], ",", 
             RowBox[{"j", "--"}]}], "]"}], ",", "\n", "\n", "\n", "\n", 
           "\t\t\t\t", 
           RowBox[{
            RowBox[{"new", "=", 
             RowBox[{"fun", "[", 
              RowBox[{
               RowBox[{"ls1", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"ls2", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", "\n", "\n", 
            "\t\t\t\t", 
            RowBox[{"rgQ", "=", 
             RowBox[{"min", "<=", "new", "<=", "max"}]}], ";", "\n", "\n", 
            "\t\t\t\t", 
            RowBox[{"If", "[", 
             RowBox[{"rgQ", ",", "\n", "\t\t\t\t\t", 
              RowBox[{"begin", "=", "False"}]}], "]"}], ";", "\n", "\n", 
            "\t\t\t\t", 
            RowBox[{"Which", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"new", ">", "max"}], "&&", 
               RowBox[{"sign", "===", "1"}]}], ",", "\n", "\t\t\t\t\t\t", 
              RowBox[{"end", "=", "True"}], ",", "\n", "\t\t\t\t\t", 
              RowBox[{
               RowBox[{"new", "<", "min"}], "&&", 
               RowBox[{"sign", "===", 
                RowBox[{"-", "1"}]}]}], ",", "\n", "\t\t\t\t\t\t", 
              RowBox[{"end", "=", "True"}]}], "]"}], ";", "\n", "\n", 
            "\t\t\t\t", 
            RowBox[{"Which", "[", "\n", "\t\t\t\t\t", 
             RowBox[{
              RowBox[{"rgQ", "&&", 
               RowBox[{"!", "begin"}]}], ",", "\n", "\t\t\t\t\t\t", 
              RowBox[{"outer", "[", 
               RowBox[{"\"\<Append\>\"", ",", "new"}], "]"}], ",", "\n", 
              "\t\t\t\t\t", 
              RowBox[{"begin", "&&", 
               RowBox[{"!", "end"}]}], ",", "\n", "\t\t\t\t\t\t", 
              RowBox[{"(*", 
               RowBox[{
               "this", " ", "should", " ", "be", " ", "avoided", " ", "with", 
                " ", "better", " ", "splitting"}], "*)"}], "\n", 
              "\t\t\t\t\t\t", 
              RowBox[{
               RowBox[{"Echo", "[", 
                RowBox[{"{", 
                 RowBox[{"\"\<redundant\>\"", ",", 
                  RowBox[{"ls1", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", 
                  RowBox[{"ls2", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "}"}], "]"}], ";", "\n", 
               "\t\t\t\t\t\t", 
               RowBox[{"Continue", "[", "]"}]}], ",", "\n", "\t\t\t\t\t", 
              "True", ",", "\n", "\t\t\t\t\t\t", 
              RowBox[{"Break", "[", "]"}]}], "]"}]}]}], "]"}]}]}], "]"}], ";",
       "\n", "\n", "\t\t", 
      RowBox[{"Normal", "@", "outer"}]}]}], "]"}], "//", 
   "QuietEcho"}]}]], "Input",
