Cell[CellGroupData[{

Cell["General testing method", "Subsubsection",
 TaggingRules->{},ExpressionUUID->"07a64df0-902d-4741-aca6-52b0ac477a72"],

Cell["\<\
The following general method is simpler to implement but also \"naive\" in \
the sense that it uses the default inefficient version of Outer. Then it can \
be used as a method for testing the more sophisticated efficient \
implementation with monotonicOuter.\
\>", "Text",
 TaggingRules->{},ExpressionUUID->"d119350e-8996-4d6d-83e7-d510059bc8d0"],

Cell["\<\
(It is also currently the default method for direct trigonometric functions.)\
\
\>", "Text",
 TaggingRules->{},ExpressionUUID->"f56199b4-80e5-49c4-99aa-bbda51e3c9a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "elementary", " ", "testing", " ", "range", " ", "with", " ", "only", " ", 
    "one", " ", "function", " ", "at", " ", "a", " ", "time"}], "*)"}], "\n", 
  "\n", 
  RowBox[{
   RowBox[{"ClearAll", "[", "elemNaiveRange", "]"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"elemNaiveRange", "[", 
      RowBox[{"x_", ",", "y_", ",", "z_", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"fun", ":", 
          RowBox[{"_Symbol", "|", "_String"}], ":", "Exp"}], ",", "1"}], 
        "}"}], ",", 
       RowBox[{"opt_String", ":", "\"\<Rational\>\""}]}], "]"}], "/;", 
     RowBox[{"NumericQ", "[", "z", "]"}]}], ":=", "\n", 
    RowBox[{"Block", "[", "\n", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rgmain", ",", 
        RowBox[{"min", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"x", "<", "y"}], ",", "x", ",", "y"}], "]"}]}], ",", 
        RowBox[{"max", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"x", "<", "y"}], ",", "y", ",", "x"}], "]"}]}]}], "}"}], ",",
       "\n", "\n", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"arguments", " ", "basic", " ", "range"}], ",", " ", 
        RowBox[{"to", " ", "be", " ", "restricted", " ", "below"}]}], "*)"}], 
      "\n", 
      RowBox[{
       RowBox[{"rgmain", "=", 
        RowBox[{"range", "[", 
         RowBox[{"x", ",", "y", ",", "z", ",", "opt"}], "]"}]}], ";", "\n", 
       "\n", 
       RowBox[{"DeleteCases", "[", "\n", 
        RowBox[{
         RowBox[{"Select", "[", "\n", "\n", 
          RowBox[{
           RowBox[{
            RowBox[{"Outer", "[", "\n", "\n", 
             RowBox[{"(*", 
              RowBox[{"function", " ", "with", " ", "two", " ", "arguments"}],
               "*)"}], "\n", 
             RowBox[{
              RowBox[{
               RowBox[{"Which", "[", "\n", 
                RowBox[{
                 RowBox[{"MemberQ", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"Exp", ",", "Log", ",", 
                    RowBox[{"Splice", "@", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    "$trig", ",", "$hyp", ",", "$invtrig", ",", "$invhyp"}], 
                    "]"}]}]}], "}"}], ",", "fun"}], "]"}], ",", "\n", "\t", 
                 RowBox[{"#1", " ", 
                  RowBox[{"fun", "[", "#2", "]"}]}], ",", "\n", 
                 RowBox[{"fun", "===", "Power"}], ",", "\n", "\t", 
                 RowBox[{"#2", "^", "#1"}], ",", "\n", "True", ",", "\n", 
                 "\t", "$Failed"}], "]"}], "&"}], ",", "\n", "\n", 
              RowBox[{"(*", 
               RowBox[{"first", " ", "argument"}], "*)"}], "\n", 
              RowBox[{"Which", "[", "\n", "\t", 
               RowBox[{
                RowBox[{"MemberQ", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"Exp", ",", "Log", ",", 
                    RowBox[{"Splice", "@", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    "$trig", ",", "$hyp", ",", "$invtrig", ",", "$invhyp"}], 
                    "]"}]}]}], "}"}], ",", "fun"}], "]"}], ",", "\n", "\t\t", 
                "rgmain", ",", "\n", "\t", 
                RowBox[{"fun", "===", "Power"}], ",", "\n", "\t\t\t", 
                RowBox[{"DeleteCases", "[", 
                 RowBox[{"rgmain", ",", "_Rationals"}], "]"}]}], "]"}], ",", 
              "\n", "\n", 
              RowBox[{"(*", 
               RowBox[{"second", " ", "argument"}], "*)"}], "\n", 
              RowBox[{"Which", "[", "\n", "\n", "\t\t", 
               RowBox[{
                RowBox[{"MemberQ", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                   "Log", ",", "Power", ",", "Coth", ",", "Csch", ",", 
                    "ArcCosh", ",", "ArcTanh", ",", "ArcCoth", ",", "ArcSech",
                     ",", "ArcCsch", ",", "Tan", ",", "Sec", ",", "Cot", ",", 
                    "Csc", ",", "ArcSin", ",", "ArcCos", ",", "ArcCot", ",", 
