Cell[TextData[{
 "It many circumstances (such as creative writing or plot labeling) it is \
often desirable to format strings with a certain ",
 ButtonBox["Style",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Style"],
 ", without losing the property of them being an actual ",
 ButtonBox["String",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/String"],
 "."
}], "Notes",
 TaggingRules->{},
