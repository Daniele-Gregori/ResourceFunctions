Cell[BoxData[{
 RowBox[{"ClearAll", "[", "StringStyleJoin", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"StringStyleJoin", "[", "]"}], "=", "\"\<\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"StringStyleJoin", "[", "syl_Style", "]"}], ":=", 
  "\[IndentingNewLine]", "\t", 
  RowBox[{"\"\<\\!\\(\\*\>\"", "<>", 
   RowBox[{"ToString", "@", 
    RowBox[{"ToBoxes", "@", "syl"}]}], "<>", "\"\<\\)\>\""}]}], "\n", 
 RowBox[{
  RowBox[{"StringStyleJoin", "[", 
   RowBox[{"s1_String", ",", "syl_Style"}], "]"}], ":=", 
  "\[IndentingNewLine]", "\t", 
  RowBox[{"s1", "<>", 
   RowBox[{"StringStyleJoin", "@", "syl"}]}]}], "\n", 
 RowBox[{
  RowBox[{"StringStyleJoin", "[", 
   RowBox[{"syl_Style", ",", "sm1_String"}], "]"}], ":=", 
  "\[IndentingNewLine]", "\t", 
  RowBox[{
   RowBox[{"StringStyleJoin", "@", "syl"}], "<>", "sm1"}]}], "\n", 
 RowBox[{
  RowBox[{"StringStyleJoin", "[", "s__", "]"}], ":=", "\[IndentingNewLine]", 
  "\t", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sq", "=", "\"\<\>\""}], ",", 
      RowBox[{"stp", "=", 
       RowBox[{
        RowBox[{"{", "s", "}"}], "/.", 
        RowBox[{"syl_Style", ":>", 
         RowBox[{"\"\<\\!\\(\\*\>\"", "<>", 
          RowBox[{"ToString", "@", 
           RowBox[{"ToBoxes", "@", "syl"}]}], "<>", "\"\<\\)\>\""}]}]}]}]}], 
     "}"}], ",", "\[IndentingNewLine]", "\t\t", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sq", ",", "stp"}], "}"}], "=", 
      RowBox[{"TakeDrop", "[", 
       RowBox[{"stp", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", "\t\t", 
     RowBox[{"sq", "<>", 
      RowBox[{"StringStyleJoin", "[", 
       RowBox[{"Sequence", "@@", "stp"}], "]"}]}]}]}], "]"}]}]}], "Input",
 TaggingRules->{},
 InitializationCell->True,
