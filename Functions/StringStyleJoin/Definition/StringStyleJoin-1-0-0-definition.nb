Cell["Properties and Relations", "Subsection",
 TaggingRules->{},
 CellTags->
  "DefaultContent",ExpressionUUID->"6860162d-f1c0-4367-815b-63c8da338b91"],

Cell[TextData[{
 "The output of ",
 Cell[BoxData[Cell[TextData[Cell[BoxData[
   FormBox["StringStyleJoin", TraditionalForm]],ExpressionUUID->
   "b94e9dcb-64c2-45ef-9509-8258b609d386"]],ExpressionUUID->
   "d34eb017-39de-41ed-860d-95bee2791170"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "991bdc71-c634-431b-b07c-029ecd7684bb"],
 " is similar to that of ",
 Cell[BoxData[
  RowBox[{
   TagBox[
    ButtonBox[
     StyleBox["ResourceFunction", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.854902, 0.396078, 0.145098]}, {
        "Link"}]],
     ButtonData->"paclet:ref/ResourceFunction",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "[", 
   TagBox[
    ButtonBox[
     StyleBox[
      StyleBox["\"\<StringReplaceRow\>\"", "ResourceFunctionsRefLink",
       ShowStringCharacters->True,
       FontFamily->"Source Sans Pro"], "StringTypeLink",
      StripOnInput->False],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"resourcefunction/StringReplaceRow",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0a9f059d-f96f-494d-b13e-9f551cb527f4"],
 ", with the main difference being that ",
 Cell[BoxData["StringStyleJoin"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "88729af9-274d-48c6-9f0c-11bfab4d2696"],
 " maintains the expression as a ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["String", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/String",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8322a90a-cfb1-4395-b715-5dd215cca1ff"],
 ":"
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.970896207862974*^9, 3.9708962892004642`*^9}, {
