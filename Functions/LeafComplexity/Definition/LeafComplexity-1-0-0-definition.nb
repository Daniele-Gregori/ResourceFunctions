Cell[BoxData[
 RowBox[{
  RowBox[{"log2Exp2Complexity", "[", "range_", "]"}], ":=", 
  RowBox[{"LeafComplexity", "[", 
   RowBox[{"range", ",", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", "#"}], "]"}]}], "]"}], "&"}], ",", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"#1", "-", 
       RowBox[{"Exp", "[", "#2", "]"}]}], "]"}], "&"}]}], "]"}]}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.993548835602268*^9, 3.993548849698544*^9}, {
