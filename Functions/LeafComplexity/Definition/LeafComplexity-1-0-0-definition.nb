Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr", "=", 
         RowBox[{"Range", "[", "n", "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"llec", "=", 
         RowBox[{"log2Exp2Complexity", "[", "expr", "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"n", ",", 
         RowBox[{"N", "@", "llec"}], ",", "llec"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "12"}], "}"}]}], "]"}], "~", "Prepend", "~", 
   RowBox[{"{", 
    RowBox[{"\"\<n\>\"", ",", "\"\<N[Log2Exp2Complexity[Range[n]]\>\"", 
     ",", "\"\<Log2Exp2Complexity[Range[n]]\>\""}], "}"}]}], "//", 
  "TableForm"}]], "Input",
 TaggingRules->{},
