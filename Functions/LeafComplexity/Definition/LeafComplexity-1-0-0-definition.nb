Cell[BoxData[
 RowBox[{
  RowBox[{"casesLC", "[", "expr_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"1", "+", 
   RowBox[{"Total", "[", 
    RowBox[{"Abs", "/@", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"#", "//.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"_Symbol", "?", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"!", 
                   RowBox[{"NumericQ", "[", "#", "]"}]}], "&"}], ")"}]}], "->",
                "1"}], ",", 
              RowBox[{"c_Complex", ":>", 
               RowBox[{"ReIm", "[", "c", "]"}]}], ",", 
              RowBox[{"r_Rational", ":>", 
               RowBox[{"NumeratorDenominator", "[", "r", "]"}]}]}], "}"}]}], ",", 
           RowBox[{"_", "?", "NumericQ"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "Infinity"}], "}"}], ",", 
           RowBox[{"Heads", "->", "True"}]}], "]"}], "&"}], ",", 
        RowBox[{"Cases", "[", 
         RowBox[{"expr", ",", 
          RowBox[{
           RowBox[{"_", "?", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
               RowBox[{"AtomQ", "[", "#", "]"}]}], "&"}], ")"}]}], "|", 
           RowBox[{"_Symbol", "?", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"NumericQ", "[", "#", "]"}]}], "&"}], ")"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "Infinity"}], "}"}], ",", 
          RowBox[{"Heads", "->", "True"}]}], "]"}]}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.992783761862481*^9, 3.992783900915634*^9}, {
  3.992783970110026*^9, 3.99278399551433*^9}, {3.992784048622333*^9, 
