  "Details & Options", "Notes", 
   "TemplateCellGroup"},ExpressionUUID->"e806a6a3-185b-4039-855b-\
458618dec7bf"],

Cell[TextData[{
 "Any Wolfram Language expression can be broken down as a ",
 ButtonBox["TreeForm",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/TreeForm"],
 ". An expression's ",
 ButtonBox["LeafCount",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/LeafCount"],
 " gives its total number of indivisible subexpressions or leaves."
}], "Notes",
 TaggingRules->{},
 CellEventActions->{Inherited, {"KeyDown", "\t"} :> Replace[SelectionMove[
       SelectedNotebook[], After, Cell]; NotebookFind[
       SelectedNotebook[], "TabNext", Next, CellTags, AutoScroll -> True, 
       WrapAround -> True], Blank[NotebookSelection] :> SelectionMove[
       SelectedNotebook[], All, CellContents, AutoScroll -> True]], 
   PassEventsDown -> False, PassEventsUp -> False},
 CellChangeTimes->{{3.992761019250371*^9, 3.992761165868285*^9}, {
  3.9927616069804087`*^9, 3.992761624123465*^9}, {3.992762527692671*^9, 
  3.992762554675844*^9}, {3.9927628312645807`*^9, 3.992762841872518*^9}, {
  3.99278565935505*^9, 3.9927857348972*^9}, {3.992786192704033*^9, 
  3.992786194473414*^9}, {3.9931349874273376`*^9, 3.9931350256684875`*^9}},
 CellTags->{
  "DefaultContent", 
   "TabNext"},ExpressionUUID->"243d4bb8-fc74-4ef8-a45e-f6fbd65c3c65"],

Cell[TextData[{
 "LeafComplexity directly extends ",
 ButtonBox["LeafCount",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/LeafCount"],
 " by weighing each leaf by its ",
 ButtonBox["absolute",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Abs"],
 " numeric value and then taking their sum. If a leaf is non-",
 ButtonBox["numeric",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NumericQ"],
 ", it is counted by default as 1. Even if already ",
 ButtonBox["atoms",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/AtomQ"],
 ", expressions with ",
 ButtonBox["Rational",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Rational"],
 ", ",
 ButtonBox["Complex",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Complex"],
 " or ",
 ButtonBox["Association",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Association"],
 " heads are decomposed into their subparts."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.992761147462953*^9, 3.9927612801916943`*^9}, {
  3.992762579480589*^9, 3.9927625878811913`*^9}, {3.99276297424861*^9, 
  3.9927630161019783`*^9}, {3.992763050715843*^9, 3.992763054968553*^9}, {
  3.9927831140671*^9, 3.992783114412201*^9}, {3.992786067040476*^9, 
  3.992786073048077*^9}, {3.992786206504712*^9, 3.992786234789563*^9}, {
  3.992791527639286*^9, 3.992791528313641*^9}, {3.9931350475393047`*^9, 
  3.993135052795456*^9}, {3.9935425995782633`*^9, 3.993542602841898*^9}, {
  3.993542678358478*^9, 
  3.993542683361269*^9}},ExpressionUUID->"230c8d89-8198-40d3-9f14-\
80049bb4a5db"],

Cell[TextData[{
 Cell[BoxData["LeafComplexity"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0f80e505-13ea-437a-ba19-6a9d82137346"],
 " also accepts as second argument a custom ",
 ButtonBox["Function",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Function"],
 " ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]],ExpressionUUID->
  "05870cd3-4080-4cc5-820c-c219b9c8b195"],
 " to be applied to all leaves before taking their ",
 ButtonBox["Total",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Total"],
 ". Even more generally, a third argument can be specified to recursively ",
 ButtonBox["Apply",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Apply"],
 " to each function-of-the-leaf another unary or binary function ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]],ExpressionUUID->
  "7831829e-3366-4793-a154-903f34a875cc"],
 ". Setting this to ",
 ButtonBox["Plus",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Plus"],
 " recovers the other definitions ",
 ButtonBox["UpTo",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/UpTo"],
 " two arguments."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.992866124417308*^9, 3.992866177317347*^9}, {
  3.99286621328253*^9, 3.992866225771267*^9}, {3.9931352069132957`*^9, 
  3.9931352276704063`*^9}, {3.99354259081371*^9, 3.9935428772476377`*^9}, {
  3.993542907635771*^9, 3.993542917155634*^9}, {3.993542947388055*^9, 
  3.993543068188066*^9}, {3.993543110828795*^9, 3.993543146723962*^9}, {
  3.993544546385118*^9, 3.993544546767111*^9}, {3.993546009186194*^9, 
  3.99354600942915*^9}, {3.9935474597737627`*^9, 3.993547489318777*^9}, {
  3.993548240448441*^9, 3.993548241888082*^9}, {3.993548339146976*^9, 
  3.993548340714883*^9}, {3.9935507518841543`*^9, 
  3.9935507826537046`*^9}},ExpressionUUID->"87b4acd7-714a-4e26-86b6-\
6a911e84a288"],

