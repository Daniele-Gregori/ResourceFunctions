Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"n\"\>", "\<\"N[Log2Exp2Complexity[Range[n]]\"\>", \
"\<\"Log2Exp2Complexity[Range[n]]\"\>"},
    {"1", "0.`", "0"},
    {"2", 
     RowBox[{"-", "0.36787944117144233`"}], 
     RowBox[{"-", 
      FractionBox["1", "\[ExponentialE]"]}]},
    {"3", 
     RowBox[{"-", "0.509292760087165`"}], 
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      SuperscriptBox["\[ExponentialE]", 
