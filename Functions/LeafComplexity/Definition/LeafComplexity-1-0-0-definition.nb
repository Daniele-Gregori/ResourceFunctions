Cell[TextData[{
 Cell[BoxData["LeafComplexity"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4c4c63fe-992f-4447-8b2e-f106c65b65b0"],
 "[",
 Cell[BoxData[
  FormBox[
   StyleBox["expr", "TI"], TraditionalForm]],ExpressionUUID->
  "59d05a34-debc-4a5e-864e-d580a6b6e9a9"],
 "] can be also computed in terms of ",
 ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"],
 " as follows:"
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.992765812424391*^9, 3.992765841071561*^9}, {
   3.992765872298424*^9, 3.9927658892892036`*^9}, {3.992784139445162*^9, 
   3.99278413958407*^9}, {3.992785092015307*^9, 3.992785115228554*^9}, {
   3.992785227452688*^9, 3.992785241908533*^9}, {3.992785282247954*^9, 
   3.992785311798468*^9}, 3.992785396750839*^9, {3.992788946055963*^9, 
   3.992788946554667*^9}, 3.9927904165485573`*^9, {3.9927904794887447`*^9, 
   3.9927904794905453`*^9}, {3.993547694722793*^9, 
   3.993547694722941*^9}},ExpressionUUID->"fc2c5641-c387-4adf-a3e9-\
1f4d86015b1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"casesLC", "[", "expr_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"1", "+", 
   RowBox[{"Total", "[", 
    RowBox[{"Abs", "/@", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"#", "//.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"_Symbol", "?", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"!", 
                   RowBox[{"NumericQ", "[", "#", "]"}]}], "&"}], ")"}]}], "->",
                "1"}], ",", 
              RowBox[{"c_Complex", ":>", 
               RowBox[{"ReIm", "[", "c", "]"}]}], ",", 
              RowBox[{"r_Rational", ":>", 
               RowBox[{"NumeratorDenominator", "[", "r", "]"}]}]}], "}"}]}], ",", 
           RowBox[{"_", "?", "NumericQ"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "Infinity"}], "}"}], ",", 
           RowBox[{"Heads", "->", "True"}]}], "]"}], "&"}], ",", 
        RowBox[{"Cases", "[", 
         RowBox[{"expr", ",", 
          RowBox[{
           RowBox[{"_", "?", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
               RowBox[{"AtomQ", "[", "#", "]"}]}], "&"}], ")"}]}], "|", 
           RowBox[{"_Symbol", "?", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"NumericQ", "[", "#", "]"}]}], "&"}], ")"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "Infinity"}], "}"}], ",", 
          RowBox[{"Heads", "->", "True"}]}], "]"}]}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.9927851909645*^9, 3.992785203243827*^9}, 
   3.992788938768422*^9, 3.992791016998003*^9, {3.993544229631822*^9, 
   3.9935442311222477`*^9}, {3.993550635950749*^9, 3.9935506361931467`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"8d55724e-2457-4fb6-b782-a22a51c2172d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"expr", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"x", "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "3"}], ")"}]}]}], "+", "I"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"x", "-", "2", "-", 
       RowBox[{"3", "I"}]}], ")"}]}], "-", " ", 
    RowBox[{"5", "/", 
     RowBox[{"x", "^", "2"}]}]}]}], ";"}]], "Input",
