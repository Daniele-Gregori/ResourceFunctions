Cell[TextData[{
 "If the order of records does not matter, setting the option \"KeepOrder\" \
to ",
 ButtonBox["False",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/False"],
 " can vastly speed up computations - see an example with a very large \
tabular in Possible Issues."
}], "Text",
 TaggingRules->{},
