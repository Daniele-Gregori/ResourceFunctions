Cell["\<\
The main bottleneck seems the internal permutation of row indexes after the \
transformation of the sub-tabular of selected rows:\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{4.003573717823449*^9, 4.003573730706846*^9}, {
  4.003574044893264*^9, 4.0035740730955477`*^9}, {4.003574301877277*^9, 
  4.0035743035500393`*^9}, {4.0035774401573763`*^9, 4.003577440397566*^9}, {
  4.003577840491776*^9, 4.0035778522048807`*^9}, {4.00357788370891*^9, 
  4.003577905685288*^9}, {4.003578195714671*^9, 4.003578204167178*^9}, {
  4.003815520806872*^9, 4.003815520904748*^9}, {4.003816111138908*^9, 
  4.003816112047254*^9}},ExpressionUUID->"0b92b781-4117-4792-8a03-\
9f0c0d871edf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"allrows", "=", 
        RowBox[{"Range", "@", 
         RowBox[{"Length", "[", "tabL", "]"}]}]}], ",", 
       RowBox[{"rows", "=", "randrows"}]}], "}"}], ",", "\[IndentingNewLine]",
      "\t", 
     RowBox[{"{", 
      RowBox[{"complrows", "=", 
       RowBox[{"Complement", "[", 
        RowBox[{"allrows", ",", "rows"}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "\t\t", 
     RowBox[{"Permute", "[", "\[IndentingNewLine]", "\t\t\t\t", 
      RowBox[{"allrows", ",", "\[IndentingNewLine]", "\t\t\t\t", 
       RowBox[{
        RowBox[{"FindPermutation", "[", "\[IndentingNewLine]", "\t\t\t\t\t", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"complrows", ",", "rows"}], "]"}], ",", "allrows"}], "]"}],
         "~", "EchoTiming", "~", "FindPermutation"}]}], "]"}]}], "]"}], ";"}],
   "//", "AbsoluteTiming"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{4.003573738741948*^9, 4.003573742604869*^9}, {
  4.003573833431183*^9, 4.003573927032015*^9}, {4.003573957750359*^9, 
  4.003573962202132*^9}, {4.0035739968056517`*^9, 4.003573999384862*^9}},
 CellLabel->
  "In[195]:=",ExpressionUUID->"5b0c9634-e275-46cf-aa03-2a201a98ced6"],

