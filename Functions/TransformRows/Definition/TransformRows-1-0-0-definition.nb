Cell["\<\
For example, one may replace missing values with others coming from a \
different source:\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{4.003577185244466*^9, 4.00357724523033*^9}, {
  4.0035787090463037`*^9, 4.003578719637344*^9}, {4.0038160578523293`*^9, 
  4.00381605800636*^9}},ExpressionUUID->"f624d013-b203-4e40-9398-\
95c45e98ffc9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"missingValues", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Castelli\>\"", "->", "11920.21"}], ",", 
     RowBox[{"\"\<Cassiglio\>\"", "->", "13080.55"}]}], "|>"}]}], 
  ";"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{4.003574864679124*^9, 4.003574869643962*^9}, 
   4.003574965325807*^9, {4.003575019569594*^9, 4.0035750463278227`*^9}},
 CellLabel->
  "In[183]:=",ExpressionUUID->"d060ae17-a82c-4a41-9edd-412a4b234c9e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransformRows", "[", 
  RowBox[{"tabData", ",", "\[IndentingNewLine]", 
   RowBox[{"Function", "[", 
    RowBox[{"StringContainsQ", "[", 
     RowBox[{"#municipality", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Castelli\>\"", ",", "\"\<Cassiglio\>\""}], "}"}]}], "]"}],
     "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"\"\<amount\>\"", "->", 
     RowBox[{"Function", "[", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"mun", "=", "#municipality"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"First", "[", 
         RowBox[{
          RowBox[{"KeySelect", "[", 
           RowBox[{"missingValues", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"ResourceFunction", "[", "\"\<StringWithinQ\>\"", "]"}],
               "[", 
              RowBox[{"mun", ",", "#"}], "]"}], "&"}]}], "]"}], ",", 
          "#amount"}], "]"}]}], "]"}], "]"}]}], "}"}]}], "]"}]], "Input",
 TaggingRules->{},
