  4.003578691523106*^9}},ExpressionUUID->"40b22711-2680-4bc0-a197-\
c48349fcdd9b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransformRows", "[", 
  RowBox[{"tab", ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"2", "#a"}], "-", 
        RowBox[{"ColumnwiseValue", "[", 
         RowBox[{"Median", "[", "#b", "]"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<b\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{"#b", "+", 
        RowBox[{"ColumnwiseThread", "[", 
         RowBox[{"Accumulate", "[", "#b", "]"}], "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 TaggingRules->{},
