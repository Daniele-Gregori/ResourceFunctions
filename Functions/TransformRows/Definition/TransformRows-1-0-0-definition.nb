     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "8", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"10", ",", "0", ",", "4"}], "}"}], ",", 
