Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "iTransformRows", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"iTransformRows", "[", 
    RowBox[{
    "tab_Tabular", ",", "rows_List", ",", "fun_", ",", "ko_", ",", "schema_", 
     ",", "opts_"}], "]"}], ":=", "\[IndentingNewLine]", "\t", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "allrows", ",", "complrows", ",", "subtab", ",", "newtab", ",", "perm", 
       ",", "join"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\t\t", 
     RowBox[{
      RowBox[{"allrows", "=", 
       RowBox[{"Range", "@", 
        RowBox[{"Length", "[", "tab", "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\t\t", 
      RowBox[{"complrows", "=", 
       RowBox[{"Complement", "[", 
        RowBox[{"allrows", ",", "rows"}], "]"}]}], ";", "\[IndentingNewLine]",
       "\[IndentingNewLine]", "\t\t", 
      RowBox[{"newtab", "=", 
       RowBox[{
        RowBox[{"transformF", "[", 
         RowBox[{"tab", ",", "fun"}], "]"}], "[", "rows", "]"}]}], ";", 
      "\[IndentingNewLine]", "\t\t", 
      RowBox[{"subtab", "=", 
       RowBox[{"tab", "[", "complrows", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\t\t", 
      RowBox[{"join", "=", 
       RowBox[{"If", "[", 
        RowBox[{"ko", ",", "\[IndentingNewLine]", "\t\t\t\t", 
         RowBox[{
          RowBox[{"perm", "=", 
           RowBox[{"Permute", "[", 
            RowBox[{"allrows", ",", "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
             RowBox[{
             "FindPermutation", "[", "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
              
              RowBox[{
               RowBox[{"Join", "[", 
                RowBox[{"complrows", ",", "rows"}], "]"}], ",", "allrows"}], 
              "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t\t\t\t", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{"subtab", ",", "newtab"}], "]"}], "[", "perm", "]"}]}], ",",
          "\[IndentingNewLine]", "\t\t\t\t", 
         RowBox[{"Join", "[", 
          RowBox[{"newtab", ",", "subtab"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\t\t", 
      RowBox[{"Tabular", "[", 
       RowBox[{"join", ",", "schema", ",", "opts"}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
