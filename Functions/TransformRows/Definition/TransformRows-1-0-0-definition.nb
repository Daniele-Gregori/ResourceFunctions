Cell[TextData[{
 "For very large ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Tabular", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/Tabular",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2cca9d5c-de69-4910-b2bc-f8265bfca43c"],
 " objects, ",
 Cell[BoxData[
  RowBox[{"TransformRows", "[", 
   RowBox[{Cell[TextData[Cell[BoxData[
     StyleBox["tab", "TI"]], "InlineFormula",
     FontFamily->"Source Sans Pro",ExpressionUUID->
     "eaf6561d-c0d3-48e6-8ea8-61e57048e761"]],ExpressionUUID->
     "35a86929-206c-48b1-b06c-f206286589ea"], ",", Cell[TextData[Cell[BoxData[
    
     StyleBox["rows", "TI"]], "InlineFormula",
     FontFamily->"Source Sans Pro",ExpressionUUID->
     "8b5becd6-2e5f-46bc-9fb2-228db78ea35d"]],ExpressionUUID->
     "3cf7b5d1-d449-49f3-8f36-6a220f11f16f"], ",", Cell[TextData[Cell[BoxData[
    
     StyleBox["transform", "TI"]], "InlineFormula",
     FontFamily->"Source Sans Pro",ExpressionUUID->
     "418c3666-7f22-4d84-84c3-b296254897c4"]],ExpressionUUID->
     "dfa67559-a133-4d6d-beb4-eab2e79ea543"]}], "]"}]],
  TaggingRules->{},
  CellChangeTimes->{{4.0035672068742*^9, 4.003567367135849*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e4ab9e07-60c3-456d-ade3-f3d9c294d98d"],
 " is somewhat slower than ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["TransformColumns", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
