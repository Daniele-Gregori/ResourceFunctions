Cell[TextData[{
 "Still, in this case the analogy with ",
 ButtonBox["Trace",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Trace"],
 " is not yet perfect because ",
 Cell[BoxData[
  FormBox[
   RowBox[{"SpreadsheetTrace", "[", 
    RowBox[{
     StyleBox["file", "TI"], ",", 
     StyleBox["cell", "TI"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "a06e2683-a565-4167-af10-f23a06a58e75"],
 " treats as ",
 ButtonBox["Atom",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Atom"],
 " elements only spreadsheet formula cells and their values, ignoring numeric \
constants in relations such as C4>0 (0) and C1-C3 (-1)."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.991645055262301*^9, 3.991645342154656*^9}, {
  3.991645407591633*^9, 3.9916454575886393`*^9}, {3.991646977024995*^9, 
  3.99164705364765*^9}},ExpressionUUID->"68dd3540-7d41-4531-bf56-\
d55761a39b74"]
}, Closed]]
}, Open  ]],

