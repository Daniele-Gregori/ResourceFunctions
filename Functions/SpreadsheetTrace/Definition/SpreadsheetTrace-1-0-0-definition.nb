Cell[BoxData[
 RowBox[{
  RowBox[{"cutTrace", "[", "trace_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"ReplaceRepeated", "[", 
   RowBox[{"trace", ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"k", ":", 
        RowBox[{"{", 
         RowBox[{"_", ",", 
          RowBox[{"HoldCompleteForm", "[", 
           RowBox[{"_", "?", "StringQ"}], "]"}]}], "}"}]}], ":>", "k"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"HoldCompleteForm", "[", 
          RowBox[{"_", "?", "NumericQ"}], "]"}], ",", 
         RowBox[{"HoldCompleteForm", "[", 
          RowBox[{"_", "?", "NumericQ"}], "]"}]}], "}"}], "->", "Nothing"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"_", "[", 
        RowBox[{"___", ",", 
         RowBox[{
          RowBox[{"_", "?", "StringQ"}], ".."}]}], "]"}], "->", "Nothing"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"HoldCompleteForm", "@", "Nothing"}], "->", "Nothing"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"_", "[", 
        RowBox[{"___", ",", 
         RowBox[{"Nothing", ".."}], ",", "___"}], "]"}], "->", "Nothing"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"_", "[", 
        RowBox[{
         RowBox[{"_", "[", 
          RowBox[{"___", ",", 
           RowBox[{
            RowBox[{"__", "?", "StringQ"}], ".."}]}], "]"}], ".."}], "]"}], "->",
        "Nothing"}]}], "}"}]}], "]"}]}]], "Input",
 TaggingRules->{},
