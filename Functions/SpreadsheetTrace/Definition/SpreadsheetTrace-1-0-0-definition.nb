Cell[TextData[{
 "In some examples, to achieve complete analogy with Excel formulas, Wolfram \
built-in functions like ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["If", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/If",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "93f0e2c1-1aeb-4ed0-8df2-469f9ada041e"],
 " need to be redefined so to be cleared of ",
 ButtonBox["Attributes",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Attributes"],
 " like ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["HoldRest", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/HoldRest",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b5d892b0-ce50-464f-9b31-67485004249f"],
 ":"
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.991635780568022*^9, 3.99163586371467*^9}, {
   3.991635955710092*^9, 3.991635989425003*^9}, {3.991643478822068*^9, 
