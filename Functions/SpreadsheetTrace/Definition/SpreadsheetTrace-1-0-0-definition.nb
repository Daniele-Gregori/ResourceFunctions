Cell["Formula parser", "Subsubsection",
 TaggingRules->{},ExpressionUUID->"95ff3d7a-53b5-4fda-ba6b-7fe55267998f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "spreadsheetFormulaParse", "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spreadsheetFormulaParse", "[", 
    RowBox[{"\"\<\>\"", ",", "___"}], "]"}], ":=", 
   RowBox[{"{", "}"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spreadsheetFormulaParse", "[", 
    RowBox[{
     RowBox[{"_", "?", "NumericQ"}], ",", "___"}], "]"}], ":=", 
   RowBox[{"{", "}"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"spreadsheetFormulaParse", "[", 
   RowBox[{"form_String", ",", "sheets_List", ",", 
    RowBox[{"nrows_", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", "\n", "\n", 
  RowBox[{"Block", "[", "\n", "\n", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "elpatt", ",", "shpatt", ",", "colpatt", ",", "cshpatt", ",", "rowqpatt",
       ",", "nrowqpatt", ",", "\n", "cellrgqF", ",", "colrgqF", ",", 
      "repcellrg", ",", "repcolrg", ",", 
      RowBox[{"sh", "=", "\"\<\>\""}], ",", 
      RowBox[{"sq", "=", "False"}]}], "}"}], ",", "\n", "\n", 
    RowBox[{"(*", "patterns", "*)"}], "\n", "\n", 
    RowBox[{
     RowBox[{"elpatt", "=", "cellPatt"}], ";", "\n", "\n", 
     RowBox[{"colpatt", "=", "colPatt"}], ";", "\n", "\n", 
     RowBox[{"shpatt", "=", 
      RowBox[{
       RowBox[{"Map", "[", "\n", "\t\t", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"s", "~~", "\"\<!\>\"", "~~", "#"}], ",", 
              RowBox[{"{", 
               RowBox[{"s", ",", "sheets"}], "}"}]}], "]"}]}], "}"}], "&"}], ",",
          "\n", "\t\t", "elpatt"}], "]"}], "//", "Flatten"}]}], ";", "\n", 
     "\n", 
     RowBox[{"cshpatt", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"s", "~~", "\"\<!\>\"", "~~", "colpatt"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "sheets"}], "}"}]}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"rowqpatt", "=", 
      RowBox[{"_", "?", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"StringCases", "[", 
           RowBox[{"#", ",", "NumberString"}], "]"}], "=!=", 
          RowBox[{"{", "}"}]}], "&"}], ")"}]}]}], ";", "\n", "\n", 
     RowBox[{"nrowqpatt", "=", 
      RowBox[{"_", "?", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"StringCases", "[", 
           RowBox[{"#", ",", "NumberString"}], "]"}], "===", 
          RowBox[{"{", "}"}]}], "&"}], ")"}]}]}], ";", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{"range", " ", "q"}], "*)"}], "\n", "\n", 
     RowBox[{"cellrgqF", "=", 
      RowBox[{
       RowBox[{"StringContainsQ", "[", 
        RowBox[{"#", ",", "\"\<:\>\""}], "]"}], "&"}]}], ";", "\n", "\n", 
     RowBox[{"colrgqF", "=", 
      RowBox[{
       RowBox[{"StringMatchQ", "[", 
        RowBox[{"#", ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
           "___", "~~", "shp", "~~", "\"\<!\>\"", "~~", "colpatt", 
            "~~", "\"\<:\>\"", "~~", "colpatt"}], ",", 
           RowBox[{"{", 
            RowBox[{"shp", ",", "sheets"}], "}"}]}], "]"}]}], "]"}], "&"}]}], 
     ";", "\n", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{"replace", " ", "cell", " ", "range"}], "*)"}], "\n", 
     RowBox[{"repcellrg", ":=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", ":", "rowqpatt"}], ",", 
         RowBox[{"b", ":", "rowqpatt"}]}], "}"}], ":>", "\n", "\t\t\t\t", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"StringDelete", "[", 
           RowBox[{"a", ",", "NumberString"}], "]"}], "<>", 
          RowBox[{"ToString", "[", "j", "]"}]}], ",", "\n", "\t\t\t\t\t\t", 
         RowBox[{"Evaluate", "@", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"row2Ind", "@", "a"}], ",", 
            RowBox[{"row2Ind", "@", "b"}]}], "}"}]}]}], "]"}]}]}], ";", "\n", 
     "\n", 
     RowBox[{"(*", 
      RowBox[{"replace", " ", "column", " ", "range"}], "*)"}], "\n", 
     RowBox[{"repcolrg", ":=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", ":", "nrowqpatt"}], ",", 
         RowBox[{"b", ":", "nrowqpatt"}]}], "}"}], ":>", "\n", "\t\t\t", 
       RowBox[{"With", "[", "\n", "\t\t\t\t", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"sc", "=", 
            RowBox[{
             RowBox[{"ssInd2Pos", "[", 
              RowBox[{
               RowBox[{"cleanCellRef", "[", "a", "]"}], "<>", "\"\<1\>\""}], 
              "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "\t\t\t\t", 
           RowBox[{"ec", "=", 
            RowBox[{
             RowBox[{"ssInd2Pos", "[", 
              RowBox[{"b", "<>", "\"\<1\>\""}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "\t\t\t\t", 
           RowBox[{"nr", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"nrows", "=!=", 
                RowBox[{"{", "}"}]}], "&&", 
               RowBox[{"MemberQ", "[", 
                RowBox[{"sheets", ",", "sh"}], "]"}]}], ",", "\n", 
              "\t\t\t\t\t\t", 
              RowBox[{"nrows", "[", 
               RowBox[{"[", 
                RowBox[{"First", "[", 
                 RowBox[{
                  RowBox[{"FirstPosition", "[", 
                   RowBox[{"sheets", ",", "sh"}], "]"}], ",", "1"}], "]"}], 
                "]"}], "]"}], ",", "\n", "\t\t\t\t\t\t", "0"}], "]"}]}]}], 
          "}"}], ",", "\n", "\n", "\t\t\t\t", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"nr", ">", "0"}], ",", "\n", "\n", "\t\t\t\t\t", 
           RowBox[{
            RowBox[{"Table", "[", "\n", "\n", "\t\t\t\t\t", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"sh", "=!=", "\"\<\>\""}], ",", "\n", 
                  "\t\t\t\t\t\t", 
                  RowBox[{"sh", "<>", "\"\<!\>\"", "<>", "#"}], ",", "\n", 
                  "\t\t\t\t\t\t", "#"}], "]"}], "&"}], "@", "\n", 
               "\t\t\t\t\t\t", 
               RowBox[{"pos2SsInd", "[", 
                RowBox[{"{", 
                 RowBox[{"r", ",", "c"}], "}"}], "]"}]}], ",", "\n", "\n", 
              "\t\t\t\t\t", 
              RowBox[{"{", 
               RowBox[{"c", ",", "sc", ",", "ec"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", "1", ",", "nr"}], "}"}]}], "]"}], "//", 
            "Flatten"}], ",", "\n", "\n", "\t\t\t\t\t", 
           RowBox[{"{", "}"}]}], "]"}]}], "]"}]}]}], ";", "\n", "\n", "\t", 
     RowBox[{"(*", 
      RowBox[{"main", " ", "parsing"}], "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"Map", "[", "\n", "\t", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", "sq"}], 
            RowBox[{"(*", 
             RowBox[{"no", " ", "column", " ", "only", " ", "ranges"}], 
             "*)"}], ",", "\n", "\n", "\t\t\t", 
            RowBox[{"StringCases", "[", 
             RowBox[{"#", ",", "\n", "\t\t", 
              RowBox[{"Join", "[", 
               RowBox[{"elpatt", ",", "shpatt"}], "]"}]}], "]"}], ",", "\n", 
            "\n", "\t\t\t", 
            RowBox[{"StringCases", "[", 
             RowBox[{"#", ",", "\n", "\t\t", 
              RowBox[{"Join", "[", 
               RowBox[{"elpatt", ",", "shpatt", ",", "cshpatt"}], "]"}]}], 
             "]"}]}], "]"}], "&"}], ",", "\n", "\n", "\n", "\t", 
         RowBox[{"Map", "[", "\n", "\n", "\t\t\t", 
          RowBox[{
           RowBox[{
            RowBox[{"Which", "[", "\n", "\n", "\t\t\t\t", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"cellrgqF", "[", "#", "]"}]}], ",", "\n", "\n", 
              "\t\t\t\t", "#", ",", "\n", "\n", "\t\t\t\t", 
              RowBox[{
               RowBox[{"cellrgqF", "[", "#", "]"}], "&&", 
               RowBox[{"!", 
                RowBox[{"colrgqF", "[", "#", "]"}]}]}], ",", "\n", "\n", 
              "\t\t\t\t", 
              RowBox[{
               RowBox[{"StringSplit", "[", 
                RowBox[{"#", ",", "\"\<:\>\""}], "]"}], "/.", "repcellrg"}], ",",
               "\n", "\n", "\t\t\t\t", 
              RowBox[{
               RowBox[{"cellrgqF", "[", "#", "]"}], "&&", 
               RowBox[{"colrgqF", "[", "#", "]"}]}], ",", "\n", "\n", 
              "\t\t\t\t", 
              RowBox[{
               RowBox[{"sh", "=", 
                RowBox[{
                 RowBox[{"StringCases", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"Alternatives", "@@", "sheets"}]}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\t\t\t\t", 
               RowBox[{"sq", "=", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"sh", "=!=", 
                   RowBox[{"{", "}"}]}], ",", "True", ",", "False"}], "]"}]}],
                ";", "\n", "\t\t\t\t", 
               RowBox[{
                RowBox[{
                 RowBox[{"StringSplit", "[", 
                  RowBox[{"#", ",", "\"\<:\>\""}], "]"}], "/.", "repcellrg"}],
                 "/.", "repcolrg"}]}]}], "]"}], "&"}], ",", "\n", "\n", "\t", 
           "\n", "\t", 
           RowBox[{"StringSplit", "[", 
            RowBox[{"form", ",", 
             RowBox[{"{", 
              RowBox[{"\"\<(\>\"", ",", "\"\<)\>\"", ",", "\"\<,\>\""}], 
              "}"}]}], "]"}], ",", "\n", "\t\t\t", "\n", "\t", 
           RowBox[{"{", "1", "}"}]}], "]"}], ",", "\n", "\t\t", 
         RowBox[{"{", "1", "}"}]}], "]"}], "\n", "\n", 
       RowBox[{"(*", "cleaning", "*)"}], "\n", "//", 
       RowBox[{
        RowBox[{"DeleteCases", "[", 
         RowBox[{"#", ",", 
          RowBox[{"Alternatives", "[", 
           RowBox[{
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", "}"}], "}"}]}], "]"}], ",", "Infinity"}], "]"}], 
        "&"}]}], "\n", "\n", 
      RowBox[{"(*", 
       RowBox[{"delete", " ", "dollar"}], "*)"}], "\n", "//", 
      RowBox[{
       RowBox[{"ReplaceAll", "[", 
        RowBox[{"#", ",", 
         RowBox[{"s_String", ":>", 
          RowBox[{"StringDelete", "[", 
           RowBox[{"s", ",", "\"\<$\>\""}], "]"}]}]}], "]"}], "&"}]}]}]}], 
   "]"}]}]}], "Input",
 TaggingRules->{},
 InitializationCell->True,
 CellLabel->"In[10]:=",ExpressionUUID->"19c37982-776e-482d-b500-9cf3a2600330"]
}, Closed]]
