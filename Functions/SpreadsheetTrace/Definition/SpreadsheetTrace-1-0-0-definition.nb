Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "SpreadsheetTrace", "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "SpreadsheetTrace", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"\"\<TraceDuplicates\>\"", "->", "True"}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SpreadsheetTrace", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sheets_List", ",", "data_List", ",", "formulas_List"}], "}"}],
       ",", "cell_String", ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "SpreadsheetTrace", "]"}]}]}], "]"}], "/;",
     "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"Depth", "@", "sheets"}], "==", "2"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Depth", "@", "data"}], ">=", "4"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Depth", "@", "formulas"}], ">=", "4"}], " ", "&&", " ", 
     RowBox[{"StringMatchQ", "[", 
      RowBox[{"cell", ",", "cellGenPatt"}], "]"}]}]}], ":=", "\n", "\t", "\n",
    "\t", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"si", ",", "optdup"}], "}"}], ",", "\n", "\t", "\n", "\t\t", 
     RowBox[{
      RowBox[{"si", "=", 
       RowBox[{"cellSheetIndex", "[", 
        RowBox[{"cell", ",", "sheets"}], "]"}]}], ";", "\t", "\n", "\t\t", 
      RowBox[{"optdup", "=", 
       RowBox[{"OptionValue", "[", "\"\<TraceDuplicates\>\"", "]"}]}], ";", 
      "\n", "\t\t", "\n", "\t\t", 
      RowBox[{"iSpreadsheetTrace", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", "cell", ",", "si", ",", 
        RowBox[{"{", 
         RowBox[{"sheets", ",", "data", ",", "formulas"}], "}"}], ",", 
        "optdup"}], "]"}]}]}], "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SpreadsheetTrace", "[", 
    RowBox[{
     RowBox[{"file", ":", 
      RowBox[{"_File", "|", "_String"}]}], ",", "cell_String", ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "SpreadsheetTrace", "]"}]}]}], "]"}], "/;",
    "\n", "\t", 
   RowBox[{
    RowBox[{"FileExistsQ", "[", "file", "]"}], " ", "&&", " ", 
    RowBox[{"StringMatchQ", "[", 
     RowBox[{"cell", ",", "cellGenPatt"}], "]"}]}]}], ":=", "\n", "\t", "\n", 
  "\t", 
  RowBox[{"SpreadsheetTrace", "[", "\n", "\t\t", 
   RowBox[{
    RowBox[{"importOnce", "[", 
     RowBox[{
      RowBox[{"ExpandFileName", "@", "file"}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\"\<Sheets\>\"", ",", "\"\<Data\>\"", 
         ",", "\"\<Formulas\>\""}], "}"}], "}"}]}], "]"}], ",", "cell", ",", 
    "opts"}], "]"}]}]}], "Code",
