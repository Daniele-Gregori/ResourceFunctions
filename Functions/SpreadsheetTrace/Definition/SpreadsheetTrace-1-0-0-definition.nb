Cell[TextData[{
 Cell[BoxData["SpreadsheetTrace"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9002ba8d-6cef-4779-9a1f-2acd5cac38e9"],
 " can help analyze spreadsheets by automatically tracing all the formula \
dependencies of a given cell."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.9916429127564697`*^9, 3.991643016125849*^9}, {
  3.991753963424265*^9, 
  3.9917539657934723`*^9}},ExpressionUUID->"ac2ae6db-6473-424e-99c1-\
1500fffc4ce7"],

Cell[TextData[{
 "The output of ",
 Cell[BoxData["SpreadsheetTrace"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3f618f71-4c94-4d78-ac06-7533e7968c88"],
 " closely mirrors that of ",
 ButtonBox["Trace",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Trace"],
 ", but it is cut before the actual spreadsheet evaluations occur. This is \
because not all Microsoft Excel functions are directly portable to Wolfram \
Language functions."
}], "Notes",
 TaggingRules->{},
