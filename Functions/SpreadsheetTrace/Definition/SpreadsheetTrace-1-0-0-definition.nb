Cell[BoxData[
 RowBox[{
  RowBox[{"cellPipeline", "[", 
   RowBox[{"v_List", ",", "cell_String", ",", "si_", ",", 
    RowBox[{"{", 
     RowBox[{"sheets_", ",", "data_", ",", "formulas_"}], "}"}], ",", 
    RowBox[{"optdup_", ":", "True"}]}], "]"}], ":=", "\n", "\t", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"vec", "=", "v"}], ",", "pos", ",", "dim", ",", "test", ",", 
      "nsi", ",", "fq", ",", "form", ",", "parse"}], "}"}], ",", "\n", "\n", 
    "\t\t", 
    RowBox[{
     RowBox[{"pos", "=", 
      RowBox[{"getPosition", "[", "cell", "]"}]}], ";", "\n", "\t\t", 
     RowBox[{"nsi", "=", 
      RowBox[{"cellSheetIndex", "[", 
       RowBox[{"cell", ",", "sheets", ",", "si"}], "]"}]}], ";", "\n", "\t\t", 
     RowBox[{"dim", "=", 
      RowBox[{"Dimensions", "[", 
       RowBox[{"data", "[", 
        RowBox[{"[", "nsi", "]"}], "]"}], "]"}]}], ";", "\n", "\t\t", 
     RowBox[{"test", "=", 
      RowBox[{"Not", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"pos", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<=", 
         RowBox[{"dim", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&&", 
        RowBox[{
         RowBox[{"pos", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "<=", 
         RowBox[{"dim", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";", "\n", "\t\t", 
     RowBox[{"If", "[", 
      RowBox[{"test", ",", "\n", "\t\t\t", 
       RowBox[{"Return", "@", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "}"}], ",", 
          RowBox[{"{", "}"}], ",", "si"}], "}"}]}]}], "]"}], ";", "\n", "\n", 
     "\t\t", 
     RowBox[{"fq", "=", 
      RowBox[{"formulaQ", "[", 
       RowBox[{"pos", ",", "nsi", ",", "formulas"}], "]"}]}], ";", "\n", 
     "\t\t", 
     RowBox[{"form", "=", 
      RowBox[{"getFormula", "[", 
       RowBox[{"fq", ",", "pos", ",", "nsi", ",", 
        RowBox[{"{", 
         RowBox[{"data", ",", "formulas"}], "}"}]}], "]"}]}], ";", "\n", 
     "\t\t", 
     RowBox[{"parse", "=", 
      RowBox[{"getParsing", "[", 
       RowBox[{"fq", ",", "form", ",", 
        RowBox[{"{", 
         RowBox[{"sheets", ",", "data"}], "}"}], ",", "optdup"}], "]"}]}], ";",
      "\n", "\n", "\t\t", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"vec", ",", "form"}], "]"}], ";", "\n", "\n", "\t\t", 
     RowBox[{"{", 
      RowBox[{"vec", ",", "parse", ",", "nsi"}], "}"}]}]}], "]"}]}]], "Code",
