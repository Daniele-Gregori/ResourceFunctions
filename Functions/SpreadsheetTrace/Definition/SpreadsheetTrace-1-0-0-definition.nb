Cell[BoxData[
 RowBox[{
  RowBox[{"getParsing", "[", 
   RowBox[{
    RowBox[{"fq_", "?", "BooleanQ"}], ",", "form_", ",", 
    RowBox[{"{", 
     RowBox[{"sheets_", ",", 
      RowBox[{"data_", ":", 
