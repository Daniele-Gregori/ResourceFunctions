 CellTags->
  "DefaultContent",ExpressionUUID->"5a93367e-1a0d-44dc-be30-a0659cae9c2f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tabInt", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cols", "=", 
      RowBox[{
       RowBox[{"Alphabet", "[", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{";;", "10"}], "]"}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Tabular", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"AssociationThread", "[", 
        RowBox[{"cols", ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"RandomInteger", "[", "100", "]"}], ",", 
           RowBox[{"Length", "@", "cols"}]}], "]"}]}], "]"}], ",", "4"}], 
      "]"}], "]"}]}], "]"}]}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.9544132607388277`*^9, 3.954413268849391*^9}, {
