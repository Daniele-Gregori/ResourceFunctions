Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tab", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cols", "=", 
      RowBox[{
       RowBox[{"Alphabet", "[", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{";;", "4"}], "]"}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Tabular", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"AssociationThread", "[", 
        RowBox[{"cols", ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"RandomInteger", "[", 
            RowBox[{"1", "+", 
             RowBox[{"5", "*", "c"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"c", ",", 
             RowBox[{"Length", "@", "cols"}]}], "}"}]}], "]"}]}], "]"}], ",", 
       "2"}], "]"}], "]"}]}], "]"}]}]], "Input",
