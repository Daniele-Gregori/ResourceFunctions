Cell[TextData[{
 "When the function does not involve ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["ColumnwiseValue", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/ColumnwiseValue",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a0e2e107-84f4-4ab2-bd54-4fae6966ba27"],
 " or ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["ColumnwiseThread", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/ColumnwiseThread",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b19585ad-f04d-404d-ae4e-c42bc06a9bbf"],
 ", ",
 Cell[BoxData[
  RowBox[{Cell[BoxData["TransformTabular"], "InlineFormula",
    FontFamily->"Source Sans Pro",ExpressionUUID->
    "701dd95a-3996-45c0-88bf-038f778207b3"], "[", 
   RowBox[{
    StyleBox["tab", "TI"], ",", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b884d4e6-895b-434d-82ad-1eb60aa42a2b"],
 " is equivalent to ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Query", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/Query",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f8c611e9-0310-42af-8822-fc6792cb515f"],
 " (with ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Normal", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/Normal",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dba8876a-4d09-4112-ac21-5b57eb7a4a95"],
 "):"
}], "Text",
 TaggingRules->{},
