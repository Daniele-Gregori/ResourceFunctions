Cell["Given a simple tabular with many columns:", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.954413207530876*^9, 3.954413212169942*^9}, {
  3.9544132798345346`*^9, 3.9544132915526237`*^9}, {3.9544134803038282`*^9, 
