Cell[TextData[{
 Cell[BoxData[
  RowBox[{"TransformTabular", "[", 
   StyleBox[
    RowBox[{"tab", ",", "f"}], "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1fbb72fe-cbf4-47d7-92fd-4e34f2a049cf"],
 " is equivalent to ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["TransformColumns", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/TransformColumns",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7f9fcf06-51ae-4ae8-b41d-fb427bc7120c"],
 " with multiple function specifications. Define a ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Tabular", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
