1dc4d3c459b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tabInt", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cols", "=", 
      RowBox[{
       RowBox[{"Alphabet", "[", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{";;", "10"}], "]"}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Tabular", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"AssociationThread", "[", 
        RowBox[{"cols", ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"RandomInteger", "[", "100", "]"}], ",", 
           RowBox[{"Length", "@", "cols"}]}], "]"}]}], "]"}], ",", "4"}], 
      "]"}], "]"}]}], "]"}]}]], "Input",
 TaggingRules->{},
