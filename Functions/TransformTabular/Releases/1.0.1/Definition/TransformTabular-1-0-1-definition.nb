Cell[TextData[{
 "We can apply a transformation for each column with ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["TransformColumns", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/TransformColumns",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7a62c074-bb20-461f-819d-ea53f6d88da0"],
 ":"
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9545127130558043`*^9, 3.9545127599616747`*^9}, {
   3.954512922920021*^9, 3.954512938304441*^9}, {3.954513116280032*^9, 
   3.954513126304758*^9}, 
   3.95455889026488*^9},ExpressionUUID->"a8f8357b-bbb1-4c1f-92b7-\
603bb5293d54"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransformColumns", "[", 
  RowBox[{"tab", ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{"#a", "-", 
        RowBox[{"ColumnwiseValue", "[", 
         RowBox[{"Min", "[", "#a", "]"}], "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<b\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{"#b", "-", 
        RowBox[{"ColumnwiseValue", "[", 
         RowBox[{"Min", "[", "#b", "]"}], "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<c\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{"#c", "-", 
        RowBox[{"ColumnwiseValue", "[", 
         RowBox[{"Min", "[", "#c", "]"}], "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<d\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{"#d", "-", 
        RowBox[{"ColumnwiseValue", "[", 
         RowBox[{"Min", "[", "#d", "]"}], "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.9545121913616047`*^9, 3.954512223520746*^9}, {
   3.954512586558283*^9, 3.954512630461507*^9}, {3.954512865328068*^9, 
